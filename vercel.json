{
  "redirects": [
    { 
      "source": "/old-home", 
      "destination": "/", 
      "permanent": true 
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "regions": ["syd1"],
  "functions": {
    "api/**.ts": {
      "runtime": "nodejs18.x",
      "memory": 128,
      "maxDuration": 10
    },
    "api/**.js": {
      "runtime": "nodejs18.x",
      "memory": 128,
      "maxDuration": 10
    }
  }
}
